DATABASE_URL=postgres://mybudget:mybudget_dev@localhost:5433/mybudget
# 5433, not 5432 — this machine already has a native PostgreSQL service on 5432;
# the Docker container maps to 5433 on the host to avoid colliding with it.
# Inside docker-compose, the server container still talks to the "postgres"
# service on its internal port 5432 — this remap is host-side only.
JWT_ACCESS_SECRET=replace-with-a-long-random-value
JWT_REFRESH_SECRET=replace-with-a-different-long-random-value
PORT=4000
# --- Optional; local defaults shown in comments ---
# NODE_ENV=production            # turns off demo-account seeding and self-service Pro by default
# CORS_ORIGIN=https://prapanji.in,https://www.prapanji.in   # unset = any origin
# TRUST_PROXY=1                  # reverse-proxy hops in front of the API (0 when reached directly)
# SEED_DEMO_ACCOUNTS=false       # docker-entrypoint.sh; default true outside production
# ALLOW_SELF_TIER_CHANGE=false   # the "Try Pro" toggle; default on except in production
# APP_URL=https://prapanji.in    # base of links in password-reset / confirmation emails (default http://localhost:8080)
# APP_TIMEZONE=Asia/Kolkata      # decides when a new month/day starts for EMIs, repeating entries, budgets (default Asia/Kolkata)
# PG_POOL_MAX=10                 # database connections held by the API
# Production (NODE_ENV=production) refuses to start unless the two JWT secrets are different,
# at least 32 characters, and CORS_ORIGIN is set.

# --- Email (SMTP) — used by the nightly issue digest and account emails ---
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=<you>@gmail.com,
# SMTP_PASS=<16-char Google app password, not your account password>.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="My Budget <you@example.com>"

# --- Report issue: nightly digest (jobs/issueDigest.ts) ---
# ISSUE_DIGEST_ENABLED=true      # start the in-process nightly scheduler (off by default)
# ISSUE_DIGEST_TIME=02:00        # HH:MM in the server's local time — set TZ below
# TZ=Asia/Kolkata
# ISSUE_DIGEST_TO=you@example.com   # comma-separated; unset = every active admin's email
# ISSUE_DIGEST_MAX=25            # most new reports included per night (highest priority first)
# ANTHROPIC_API_KEY=             # optional; unset = rule-based fix suggestions instead of Claude
# ISSUE_AI_MODEL=claude-opus-5-5
