DATABASE_URL=postgres://mybudget:mybudget_dev@localhost:5433/mybudget
# 5433, not 5432 — this machine already has a native PostgreSQL service on 5432;
# the Docker container maps to 5433 on the host to avoid colliding with it.
# Inside docker-compose, the server container still talks to the "postgres"
# service on its internal port 5432 — this remap is host-side only.
JWT_ACCESS_SECRET=replace-with-a-long-random-value
JWT_REFRESH_SECRET=replace-with-a-different-long-random-value
PORT=4000
