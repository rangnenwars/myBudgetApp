{
  "name": "mybudget-server",
  "version": "1.0.0",
  "private": true,
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:plan": "tsx src/db/migratePlan.ts",
    "db:migrate:safe": "bash scripts/migrate-safe.sh --local",
    "db:seed": "tsx src/db/seed-categories.ts",
    "db:seed:accounts": "tsx src/db/seed-accounts.ts",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:unit": "jest --coverage=false accessRules clock issueAnalysis issueConstants issueSuggestions mail mailer",
    "quality": "npm run typecheck && npm run test:coverage",
    "issues:digest": "tsx src/jobs/run-issue-digest.ts",
    "issues:analyze": "tsx src/jobs/run-issue-analysis.ts"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.45.4",
    "express": "^4.21.1",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.3.0",
    "jpeg-js": "^0.4.4",
    "jsonwebtoken": "^9.0.2",
    "jsqr": "^1.4.0",
    "nodemailer": "^10.6.0",
    "pg": "^8.23.1",
    "pngjs": "^7.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^6.4.24",
    "@types/pg": "^8.11.10",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "^0.31.10",
    "jest": "^29.7.0",
    "qrcode": "^1.5.4",
    "supertest": "^7.3.2",
    "ts-jest": "^29.2.5",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2"
  },
  "overrides": {
    "qs": "^6.16.2"
  }
}
