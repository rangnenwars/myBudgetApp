{
  "expo": {
    "name": "Prapanji",
    "slug": "mybudgetapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "mybudget",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F5F6F2",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.rangnenwars.mybudget"
    },
    "android": {
      "package": "com.rangnenwars.mybudget",
      "adaptiveIcon": {
        "backgroundColor": "#0A0F1E",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "name": "Prapanji",
      "shortName": "Prapanji",
      "lang": "en",
      "description": "Prapanji: split bills with friends, track every rupee, and see where your month actually goes. Nothing forgotten, nothing hidden.",
      "themeColor": "#0F5C4A",
      "backgroundColor": "#F5F6F2",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "asyncRoutes": {
            "web": true
          }
        }
      ],
      "expo-sqlite",
      "expo-status-bar",
      "expo-splash-screen",
      "expo-sharing",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Prapanji needs access to your photos so you can attach a screenshot when reporting an issue.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "extra": {
      "eas": {}
    }
  }
}
