{
  "name": "mybudgetapp",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "3.1.1",
    "axios": "^1.20.0",
    "date-fns": "^4.4.0",
    "expo": "~57.0.9",
    "expo-constants": "~57.0.8",
    "expo-crypto": "~57.0.1",
    "expo-file-system": "~57.0.4",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.4",
    "expo-router": "~57.0.9",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.12",
    "expo-splash-screen": "~57.0.5",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-chart-kit": "^7.0.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@react-native/jest-preset": "^0.86.2",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.2.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "husky": "^9.1.7",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.4",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "typecheck": "tsc --noEmit",
    "quality": "npm run typecheck && npm run test:coverage",
    "verify": "bash scripts/verify.sh",
    "verify:docker": "bash scripts/docker-verify.sh",
    "prepare": "husky",
    "lint": "expo lint"
  },
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/.expo/",
      "/server/"
    ],
    "collectCoverageFrom": [
      "utils/calculations.ts"
    ],
    "coverageThreshold": {
      "./utils/calculations.ts": {
        "branches": 85,
        "functions": 100,
        "lines": 90,
        "statements": 90
      }
    }
  },
  "private": true
}
